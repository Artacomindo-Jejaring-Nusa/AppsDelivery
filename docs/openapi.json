{
  "openapi": "3.0.3",
  "info": {
    "title": "Delivery & Reverse Logistics Management API",
    "description": "REST API untuk sistem manajemen pengiriman dan logistik balik proyek migrasi BTS Telkomsel (4.600 titik, Kalimantan). Dibangun oleh PT. AKS X Artacomindo.",
    "version": "1.2.0",
    "contact": {
      "name": "PT. AKS X Artacomindo",
      "email": "admin@aksartacomindo.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development"
    }
  ],
  "tags": [
    { "name": "Dashboard", "description": "Analytics & Executive Summary" },
    { "name": "Uploads", "description": "Media & Document Uploads (Proof of Delivery / Dismantle Photos)" },
    { "name": "Auth", "description": "Authentication & User Management" },
    { "name": "BTS Sites", "description": "Master Data BTS Tower Locations (with CSV/Excel Import)" },
    { "name": "Drivers", "description": "Master Data Driver & GPS Location Tracking" },
    { "name": "Delivery Orders", "description": "Delivery Order Management (with CSV/Excel Import)" },
    { "name": "Manifests", "description": "Manifest (Group DOs + Assign Driver)" },
    { "name": "Dismantle Assets", "description": "Barang Bongkaran dari BTS (Inbound)" },
    { "name": "Barcodes", "description": "QR Code Generator & Scanner" },
    { "name": "Reports", "description": "Excel Report Exports" },
    { "name": "SLA", "description": "SLA Dashboard & Logs" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DashboardStats": {
        "type": "object",
        "properties": {
          "total_delivery_orders": { "type": "integer", "example": 25 },
          "today_delivery_orders": { "type": "integer", "example": 3 },
          "month_delivery_orders": { "type": "integer", "example": 25 },
          "do_status_breakdown": {
            "type": "object",
            "properties": {
              "pending": { "type": "integer", "example": 5 },
              "assigned": { "type": "integer", "example": 3 },
              "in_transit": { "type": "integer", "example": 10 },
              "delivered": { "type": "integer", "example": 4 },
              "completed": { "type": "integer", "example": 2 },
              "cancelled": { "type": "integer", "example": 1 }
            }
          },
          "sla_breakdown": {
            "type": "object",
            "properties": {
              "green": { "type": "integer", "example": 12 },
              "yellow": { "type": "integer", "example": 5 },
              "red": { "type": "integer", "example": 3 }
            }
          },
          "active_manifests": { "type": "integer", "example": 4 },
          "total_dismantle_assets": { "type": "integer", "example": 48 }
        }
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "total_rows": { "type": "integer" },
          "success": { "type": "integer" },
          "skipped": { "type": "integer" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      },
      "FileUploadResponse": {
        "type": "object",
        "properties": {
          "original_name": { "type": "string", "example": "foto_bukti_pod.jpg" },
          "saved_name": { "type": "string", "example": "20260723_150405_a1b2c3d4.jpg" },
          "size_bytes": { "type": "integer", "example": 204800 },
          "extension": { "type": "string", "example": ".jpg" },
          "url": { "type": "string", "example": "/uploads/20260723_150405_a1b2c3d4.jpg" }
        }
      },
      "DriverLocation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "driver_id": { "type": "string", "format": "uuid" },
          "latitude": { "type": "number", "example": -3.3194 },
          "longitude": { "type": "number", "example": 114.5907 },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      },
      "SaveDriverLocationRequest": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": { "type": "number", "example": -3.31940000 },
          "longitude": { "type": "number", "example": 114.59070000 }
        }
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "tags": ["Auth"],
        "responses": { "200": { "description": "API is healthy" } }
      }
    },
    "/api/v1/dashboard/stats": {
      "get": {
        "summary": "Get Executive Summary & Analytics Stats",
        "tags": ["Dashboard"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Aggregated stats for dashboard cards" } }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "summary": "Upload File/Photo (Proof of Delivery / Dismantle Photo)",
        "tags": ["Uploads"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "File uploaded successfully" } }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "admin123" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Login successful" } }
      }
    },
    "/api/v1/drivers/location": {
      "post": {
        "summary": "Submit Current GPS Coordinates (Driver only)",
        "tags": ["Drivers"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDriverLocationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Location logged successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLocation"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drivers/{id}/location": {
      "get": {
        "summary": "Get Latest GPS Coordinate of a Driver",
        "tags": ["Drivers"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Latest location returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLocation"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drivers/{id}/location/history": {
      "get": {
        "summary": "Get Location History Logs of a Driver",
        "tags": ["Drivers"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Historical coordinates returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DriverLocation"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bts-sites/import": {
      "post": {
        "summary": "Import BTS Sites via CSV/Excel",
        "tags": ["BTS Sites"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Import result summary" } }
      }
    },
    "/api/v1/delivery-orders/import": {
      "post": {
        "summary": "Import Delivery Orders via CSV/Excel",
        "tags": ["Delivery Orders"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Import result summary" } }
      }
    },
    "/api/v1/reports/export/delivery-orders": {
      "get": {
        "summary": "Export Delivery Orders Report (.xlsx)",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Excel binary file download" } }
      }
    },
    "/api/v1/reports/export/dismantle-assets": {
      "get": {
        "summary": "Export Dismantle Assets Report (.xlsx)",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Excel binary file download" } }
      }
    }
  }
}
